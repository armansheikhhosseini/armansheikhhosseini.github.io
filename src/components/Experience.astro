---
import { siteConfig } from "../config";

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{hasExperience && (
  <section id="experience" class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="section-index">03</span>
        <h2 class="h2">Experience</h2>
      </div>

      <div>
        {siteConfig.experience.map((job) => (
          <article class="row reveal">
            <div class="job-grid">
              <div class="job-when">
                <p class="meta m-0">{job.dateRange}</p>
                <p class="meta m-0 mt-1 opacity-70">{job.location}</p>
              </div>

              <div>
                <h3 class="h3">{job.company}</h3>
                <p class="job-role">{job.title}</p>

                {job.metrics.length > 0 && (
                  <ul class="flex flex-wrap gap-2 mt-4">
                    {job.metrics.map((metric) => <li class="tag tag-accent">{metric}</li>)}
                  </ul>
                )}

                <ul class="mt-5 space-y-2.5">
                  {job.bullets.map((bullet) => (
                    <li class="bullet text-[0.95rem] leading-relaxed">{bullet}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .job-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .job-grid {
      grid-template-columns: 15rem 1fr;
      gap: 3rem;
    }

    .job-when {
      position: sticky;
      top: 7rem;
    }
  }

  .job-role {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin: 0.4rem 0 0;
  }

  .bullet {
    max-width: 72ch;
  }
</style>
