---
import { siteConfig } from "../config";

const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const hasCertifications = siteConfig.certifications && siteConfig.certifications.length > 0;
---

{(hasEducation || hasCertifications) && (
  <section id="credentials" class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="section-index">04</span>
        <h2 class="h2">Credentials</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        {hasEducation && (
          <div class="lg:col-span-5">
            <h3 class="eyebrow reveal">Education</h3>
            <div class="mt-5">
              {siteConfig.education.map((edu) => (
                <div class="entry reveal">
                  <p class="meta m-0">{edu.dateRange}</p>
                  <h4 class="entry-title mt-2">{edu.degree}</h4>
                  <p class="entry-sub">{edu.school}</p>
                  <p class="prose-body text-[0.9rem] mt-2">{edu.note}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        {hasCertifications && (
          <div class="lg:col-span-7">
            <h3 class="eyebrow reveal">Certifications</h3>
            <ul class="mt-5">
              {siteConfig.certifications.map((cert) => (
                <li class="cert reveal">
                  <span class="cert-year meta">{cert.year}</span>
                  <span>
                    <span class="cert-name">{cert.name}</span>
                    <span class="cert-issuer">{cert.issuer}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .entry {
    padding-block: 1.5rem;
    border-top: 1px solid var(--hairline-soft);
  }

  .entry:last-child {
    border-bottom: 1px solid var(--hairline-soft);
  }

  .entry-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .entry-sub {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    margin: 0.35rem 0 0;
  }

  .cert {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1rem;
    border-top: 1px solid var(--hairline-soft);
  }

  .cert:last-child {
    border-bottom: 1px solid var(--hairline-soft);
  }

  .cert-name {
    display: block;
    font-size: 0.975rem;
    font-weight: 500;
    color: var(--ink);
  }

  .cert-issuer {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }
</style>
