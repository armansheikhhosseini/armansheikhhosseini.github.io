---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

// "https://github.com/user/repo" -> "user/repo"
const repoPath = (url: string) => url.replace(/^https?:\/\/(www\.)?github\.com\//, "");
---

{hasProjects && (
  <section id="work" class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="section-index">02</span>
        <h2 class="h2">Selected work</h2>
      </div>

      <div>
        {siteConfig.projects.map((project, index) => (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="row row-link project reveal"
          >
            <div class="project-grid">
              <span class="project-index">{String(index + 1).padStart(2, "0")}</span>

              <div>
                <h3 class="h3 project-title">
                  {project.name}
                  <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M9 7h8v8" />
                  </svg>
                </h3>

                <p class="prose-body mt-3">{project.description}</p>

                <ul class="flex flex-wrap gap-2 mt-5">
                  {project.skills.map((skill) => <li class="tag">{skill}</li>)}
                </ul>
              </div>

              <span class="meta project-repo">{repoPath(project.link)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .project {
    text-decoration: none;
    color: inherit;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: 4rem 1fr 14rem;
      gap: 2rem;
      align-items: start;
    }
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    padding-top: 0.35rem;
    transition: color 0.3s ease;
  }

  .project:hover .project-index {
    color: var(--accent);
  }

  .project-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: color 0.3s ease;
  }

  .project:hover .project-title {
    color: var(--accent);
  }

  .arrow {
    opacity: 0;
    translate: -6px 4px;
    transition: opacity 0.35s ease, translate 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    flex-shrink: 0;
  }

  .project:hover .arrow {
    opacity: 1;
    translate: 0 0;
  }

  .project-repo {
    padding-top: 0.5rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .project-repo {
      text-align: right;
    }
  }
</style>
