---
import { siteConfig } from "../config";

const year = new Date().getFullYear();

const links = [
  siteConfig.social.linkedin && { label: "LinkedIn", href: siteConfig.social.linkedin },
  siteConfig.social.github && { label: "GitHub", href: siteConfig.social.github },
  siteConfig.social.twitter && { label: "X", href: siteConfig.social.twitter },
  siteConfig.social.telegram && { label: "Telegram", href: siteConfig.social.telegram },
].filter(Boolean) as { label: string; href: string }[];
---

<footer id="contact" class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="section-index">05</span>
      <h2 class="h2">Contact</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-7 reveal">
        <p class="lede">
          Open to conversations about cloud platforms, infrastructure automation, and
          platform reliability.
        </p>

        <a href={`mailto:${siteConfig.social.email}`} class="email-link mt-8">
          {siteConfig.social.email}
        </a>

        {siteConfig.social.phone && (
          <p class="meta mt-4">
            <a href={`tel:${siteConfig.social.phone.replace(/\s/g, "")}`} class="link">
              {siteConfig.social.phone}
            </a>
          </p>
        )}
      </div>

      <div class="lg:col-span-5 reveal">
        <h3 class="eyebrow">Elsewhere</h3>
        <ul class="mt-5">
          {links.map((link) => (
            <li class="elsewhere">
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="elsewhere-link">
                <span>{link.label}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17L17 7M9 7h8v8" />
                </svg>
              </a>
            </li>
          ))}
          <li class="elsewhere no-print">
            <a href={siteConfig.cvUrl} download class="elsewhere-link">
              <span>Curriculum Vitae (PDF)</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v13M6 12l6 6 6-6M4 21h16" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="colophon">
      <p class="meta m-0">© {year} {siteConfig.name}</p>
      <p class="meta m-0">Built with Astro &amp; Tailwind · Deployed on GitHub Pages</p>
    </div>
  </div>
</footer>

<style>
  .email-link {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 2.6vw, 3rem);
    line-height: 1.15;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
    word-break: break-word;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.45s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s ease;
  }

  .email-link:hover {
    background-size: 100% 1px;
    color: var(--accent);
  }

  .elsewhere {
    border-top: 1px solid var(--hairline-soft);
  }

  .elsewhere:last-child {
    border-bottom: 1px solid var(--hairline-soft);
  }

  .elsewhere-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.25s ease, padding-left 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .elsewhere-link:hover {
    color: var(--accent);
    padding-left: 0.5rem;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    margin-top: clamp(3.5rem, 2rem + 5vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }
</style>
