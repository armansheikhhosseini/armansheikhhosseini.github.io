---
import { siteConfig } from "../config";

const initials = siteConfig.name
  .split(" ")
  .map((part) => part[0])
  .join("");

const nav = [
  { href: "#about", label: "About" },
  { href: "#work", label: "Work" },
  { href: "#experience", label: "Experience" },
  { href: "#credentials", label: "Credentials" },
  { href: "#contact", label: "Contact" },
];
---

<header id="site-header" class="no-print fixed top-0 inset-x-0 z-50">
  <div class="header-inner">
    <div class="wrap flex items-center justify-between h-16 md:h-[4.5rem]">
      <a href="#top" class="monogram" aria-label={`${siteConfig.name} — back to top`}>
        {initials}
      </a>

      <nav class="primary-nav" aria-label="Primary">
        <ul class="flex items-center gap-7">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link" data-nav={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <button id="theme-toggle" type="button" class="icon-btn" aria-label="Toggle colour theme">
          <svg class="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
        </button>

        <a href={siteConfig.cvUrl} download class="btn cv-btn">
          CV
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v13M6 12l6 6 6-6M4 21h16" />
          </svg>
        </a>

        <button id="menu-toggle" type="button" class="icon-btn menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path d="M3 7h18M3 12h18M3 17h18" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="h-px w-full origin-left scroll-progress"></div>
</header>

<div id="mobile-menu" class="no-print" hidden>
  <nav class="wrap py-10" aria-label="Mobile">
    <ul class="flex flex-col gap-1">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="mobile-link">{item.label}</a>
        </li>
      ))}
      <li>
        <a href={siteConfig.cvUrl} download class="mobile-link">Download CV</a>
      </li>
    </ul>
  </nav>
</div>

<style>
  .header-inner {
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }

  :global(#site-header.is-scrolled) .header-inner {
    border-bottom-color: var(--hairline);
  }

  .monogram {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    padding: 0.3rem 0.5rem;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .monogram:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    position: relative;
    padding-block: 0.25rem;
    transition: color 0.25s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 0;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--ink);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    color: var(--ink);
    background: transparent;
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .icon-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Show the icon for the theme you'd switch TO */
  .icon-btn .moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .icon-btn .sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .icon-btn .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .icon-btn .sun {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .icon-btn .moon {
      display: block;
    }
  }

  #mobile-menu {
    position: fixed;
    inset: 4rem 0 0;
    z-index: 45;
    background: var(--bg);
    overflow-y: auto;
  }

  .mobile-link {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.6;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-soft);
    transition: color 0.25s ease;
  }

  .mobile-link:hover {
    color: var(--accent);
  }

  /* Responsive visibility lives here rather than in utility classes:
     Astro's scoped styles are unlayered, so they beat Tailwind utilities.
     Kept last so it wins over the .icon-btn display above. */
  .primary-nav,
  .cv-btn {
    display: none;
  }

  .menu-btn {
    display: inline-flex;
  }

  @media (min-width: 640px) {
    .cv-btn {
      display: inline-flex;
    }
  }

  @media (min-width: 768px) {
    .primary-nav {
      display: block;
    }
    .menu-btn {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const themeToggle = document.getElementById("theme-toggle");
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  // Hairline under the header once the page has moved
  const onScroll = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 8);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Theme toggle — persists the explicit choice, otherwise follows the system
  themeToggle?.addEventListener("click", () => {
    const root = document.documentElement;
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const current = root.dataset.theme || (systemDark ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* storage blocked — the toggle still works for this page view */
    }
  });

  // Mobile menu
  const setMenu = (open: boolean) => {
    if (!mobileMenu) return;
    mobileMenu.hidden = !open;
    menuToggle?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };

  menuToggle?.addEventListener("click", () => setMenu(mobileMenu?.hidden ?? true));
  mobileMenu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setMenu(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  // Highlight the section currently in view
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav]"));
  const sections = links
    .map((link) => document.querySelector(link.dataset.nav || ""))
    .filter((el): el is Element => Boolean(el));

  if (sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => {
            link.classList.toggle("is-active", link.dataset.nav === `#${entry.target.id}`);
          });
        });
      },
      { rootMargin: "-45% 0px -50% 0px" }
    );
    sections.forEach((section) => spy.observe(section));
  }
</script>
