---
import { siteConfig } from "../config";

const keyTech = ["AWS", "Kubernetes", "Terraform", "Argo CD", "Python"];
---

<section id="top" class="wrap pt-32 md:pt-44 pb-[clamp(3rem,2rem+5vw,6rem)]">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end">
    <div class="lg:col-span-7 reveal">
      <p class="eyebrow flex items-center gap-2.5">
        <span class="pulse-dot" aria-hidden="true"></span>
        {siteConfig.title} — {siteConfig.social.location}
      </p>

      <h1 class="display mt-6">{siteConfig.name}</h1>

      <p class="lede mt-7">{siteConfig.tagline}</p>

      <ul class="flex flex-wrap gap-2 mt-8" aria-label="Core technologies">
        {keyTech.map((tech) => <li class="tag">{tech}</li>)}
      </ul>

      <div class="flex flex-wrap items-center gap-3 mt-9 no-print">
        <a href={siteConfig.cvUrl} download class="btn btn-primary">
          Download CV
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v13M6 12l6 6 6-6M4 21h16" />
          </svg>
        </a>
        <a href={`mailto:${siteConfig.social.email}`} class="btn">
          Get in touch
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M9 7h8v8" />
          </svg>
        </a>
      </div>
    </div>

    <figure class="lg:col-span-5 reveal m-0">
      <div class="portrait">
        <img
          src="/profile-photo.jpg"
          alt={siteConfig.name}
          width="800"
          height="800"
          loading="eager"
          decoding="async"
        />
      </div>
      <figcaption class="meta mt-3 flex items-center justify-between">
        <span>{siteConfig.social.location}</span>
        <span>{siteConfig.yearsExperience} years in production</span>
      </figcaption>
    </figure>
  </div>

  <dl class="stats mt-[clamp(3.5rem,2rem+6vw,6rem)] reveal">
    {siteConfig.highlights.map((item) => (
      <div class="stat">
        <dt class="stat-value">{item.value}</dt>
        <dd class="stat-label">{item.label}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 60%, transparent);
    animation: pulse 2.4s ease-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 7px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  /* Portrait with an offset hairline frame behind it */
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 26rem;
    margin-left: auto;
  }

  .portrait::after {
    content: "";
    position: absolute;
    inset: 0;
    translate: 14px 14px;
    border: 1px solid var(--accent);
    opacity: 0.5;
    z-index: -1;
    transition: translate 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .portrait:hover::after {
    translate: 8px 8px;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: 1px solid var(--hairline);
  }

  @media (max-width: 1023px) {
    .portrait {
      margin-left: 0;
      max-width: 20rem;
    }
  }

  /* Stats strip */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--hairline);
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--hairline-soft);
    padding-right: 1.5rem;
  }

  @media (min-width: 768px) {
    .stat {
      border-bottom: none;
    }
    .stat + .stat {
      border-left: 1px solid var(--hairline-soft);
      padding-left: 1.5rem;
    }
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1;
    color: var(--ink);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0.6rem 0 0;
  }
</style>
