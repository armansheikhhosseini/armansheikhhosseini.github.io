---
import { siteConfig } from "../config";
---

<section id="about" class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="section-index">01</span>
      <h2 class="h2">About</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-5 reveal">
        <p class="lede">{siteConfig.aboutMe}</p>

        <dl class="mt-10 space-y-3">
          <div class="flex gap-4">
            <dt class="eyebrow w-24 shrink-0 pt-0.5">Based in</dt>
            <dd class="m-0 text-[0.95rem]">{siteConfig.social.location}</dd>
          </div>
          <div class="flex gap-4">
            <dt class="eyebrow w-24 shrink-0 pt-0.5">Languages</dt>
            <dd class="m-0 text-[0.95rem]">
              {siteConfig.languages.map((lang) => `${lang.name} (${lang.level})`).join(", ")}
            </dd>
          </div>
          <div class="flex gap-4">
            <dt class="eyebrow w-24 shrink-0 pt-0.5">Studying</dt>
            <dd class="m-0 text-[0.95rem]">M.Sc. Cybersecurity, Politecnico di Torino</dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-7">
        <h3 class="eyebrow reveal">Toolkit</h3>
        <div class="mt-6">
          {siteConfig.skills.map((skill) => (
            <div class="skill-row reveal">
              <h4 class="skill-group">{skill.group}</h4>
              <ul class="skill-items">
                {skill.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skill-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--hairline-soft);
  }

  .skill-row:last-child {
    border-bottom: 1px solid var(--hairline-soft);
  }

  @media (min-width: 640px) {
    .skill-row {
      grid-template-columns: 13rem 1fr;
      gap: 1.5rem;
      align-items: baseline;
    }
  }

  .skill-group {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin: 0;
  }

  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-items li {
    font-size: 0.9rem;
    color: var(--ink-2);
    position: relative;
  }

  .skill-items li + li::before {
    content: "·";
    position: absolute;
    left: -0.55rem;
    color: var(--muted);
  }
</style>
